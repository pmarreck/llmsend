#!/usr/bin/env bash
# Herdr notices; terminal wakes are an explicit, advisory opt-in.
set -u
umask 077

usage() {
	printf '%s\n' \
		'Usage: notify-session AGENT_OR_PANE MESSAGE' \
		'       notify-session AGENT_OR_PANE --wake NOTE_PATH [--timeout SECONDS] [--dry-run]' \
		'       Service opt-in: add --service-socket PATH --expect-session NATIVE_ID' \
		'Default: human notification only. --wake: guarded input for an existing inbox note.' \
		'Wake outputs JSON. Exit 3: deferred; 4: submission unconfirmed; 0: inspect status.' \
		'Timeout defaults to 60 seconds (0.25..300); never clears a human draft.' \
		'Requires HERDR_ENV=1, or explicit service mode with an operator-owned private socket.'
}

case "${1:-}" in
	-h|--help) usage; exit 0 ;;
	--about)
		printf 'notify-session 0.5.0 — Herdr LLMsend notice/wake — %s %s\n' "$(uname -s)" "$(uname -m)"
		exit 0
		;;
esac

if [ "${2:-}" = --wake ]; then
	script_dir="${LLMSEND_SCRIPT_DIR:-$(cd "$(dirname "$0")" && pwd)}"
	exec luajit "$script_dir/herdr_wake_cli.lua" "$@"
fi

if [ "$#" -ne 2 ] || [ -z "$1" ] || [ -z "$2" ]; then
	usage >&2
	exit 2
fi

session="$1"
message="$2"
case "$session" in -*|*[$'\r\n']*) printf 'invalid agent target\n' >&2; exit 2 ;; esac
case "$message" in *[$'\r\n']*) printf 'invalid notification text\n' >&2; exit 2 ;; esac

if [ "${HERDR_ENV:-}" != 1 ]; then
	printf 'Run inside the intended Herdr session; durable inbox delivery remains available outside it.\n' >&2
	exit 1
fi

herdr_command="${LLMSEND_HERDR:-herdr}"
if ! "$herdr_command" agent get "$session" >/dev/null; then
	printf 'could not resolve live Herdr agent %s\n' "$session" >&2
	exit 1
fi

# The installed Herdr notification API is session-wide, not pane-targeted.
# Including the recipient in its title avoids suggesting a targeted wake.
# This installed client requires TITLE first despite help displaying OPTIONS
# first. The fixed prefix also prevents option-shaped recipient text here.
"$herdr_command" notification show "Inbox: $session" --body "$message" --sound none >/dev/null
