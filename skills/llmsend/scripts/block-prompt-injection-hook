#!/usr/bin/env bash
# Warn about LLMsend-shaped tmux input injection without blocking it. Other
# tmux automation remains silent.
set -u

input=""
if [ ! -t 0 ]; then input="$(cat 2>/dev/null || true)"; fi
command_text="$(
	printf '%s' "$input" | jq -r '
		.tool_input.command //
		.toolInput.command //
		.input.command //
		.arguments.command //
		.command //
		empty
	' 2>/dev/null
)"
[ -n "$command_text" ] || exit 0

lower="$(printf '%s' "$command_text" | tr '[:upper:]' '[:lower:]')"
case "$lower" in
	*llmsend*|*"new inbox message"*|*"/inbox/"*|*"📬"*) ;;
	*) exit 0 ;;
esac

if printf '%s\n' "$lower" | grep -Eq '(^|[[:space:];|&"'"'"'()])([^[:space:];|&"'"'"'()]*/)?tmux[[:space:]]+(send-keys|paste-buffer|load-buffer)([[:space:];|&"'"'"'()]|$)'; then
	printf '%s\n' \
		'ADVISORY: LLMsend terminal input can overwrite a human draft.' \
		'Write the durable inbox note first, then inspect the target pane immediately before waking it.' \
		'Continue only at a demonstrably empty prompt; inspection and injection are not atomic.' >&2
fi

exit 0
