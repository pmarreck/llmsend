#!/usr/bin/env bash
set -u
root="$(cd "$(dirname "$0")/../.." && pwd)"
failures=0
for suite in inbox_reminder native_delivery; do
	output=$(luajit "$root/tests/unit/${suite}_test.lua" "$root" 2>&1)
	status=$?
	printf '%s\n' "$output"
	if [ "$status" -ne 0 ]; then failures=$((failures+1)); fi
done
exit "$failures"
