#!/usr/bin/env bash
set -u

root="$(cd "$(dirname "$0")/../.." && pwd)"
source "$root/tests/testlib"

guard="$root/skills/llmsend/scripts/block-prompt-injection-hook"
if [ ! -x "$guard" ]; then
	fail "missing executable block-prompt-injection-hook"
	finish_tests block-prompt-injection-hook
fi

run_guard() {
	local command="$1"
	guard_output="$(
		printf '%s' "$(jq -cn --arg command "$command" '{hook_event_name:"PreToolUse",tool_input:{command:$command}}')" |
			"$guard" 2>&1
	)"
	guard_status=$?
}

warned=(
	"herdr agent prompt validate 'Read /tmp/project/inbox/note.frontmatter.md'"
	"herdr agent send-keys validate enter # llmsend"
	"herdr pane run w1:p2 'echo llmsend'"
	"tmux send-keys -t validate -l '📬 New inbox message from dirtree'"
	"msg='New inbox message'; tmux paste-buffer -t validate"
	"ssh host \"tmux load-buffer -b llmsend-ping-1 -\""
	"tmux send-keys -t validate Enter # llmsend"
	"tmux send-keys -t validate -l '/home/p/Code/validate/inbox/2026-07-22-note.md'"
)

allowed=(
	"herdr agent get validate # llmsend"
	"herdr notification show --body '📬 Inbox note delivered' Inbox"
	"herdr agent read validate --lines 40 # llmsend"
	"tmux send-keys -t validate y Enter"
	"tmux display-message -t validate '📬 Inbox note delivered'"
	"printf 'New inbox message'"
	"tmux capture-pane -pt validate"
	"echo llmsend"
)

for command in "${warned[@]}"; do
	run_guard "$command"
	assert_eq 0 "$guard_status" "LLMsend-shaped terminal injection remains advisory [$command]"
	assert_contains "$guard_output" "ADVISORY" "risky terminal injection emits an advisory [$command]"
done

for command in "${allowed[@]}"; do
	run_guard "$command"
	assert_eq 0 "$guard_status" "non-injecting or non-LLMsend tmux command remains allowed [$command]"
	assert_eq "" "$guard_output" "safe command does not emit the terminal-input advisory [$command]"
done

printf '{}' | "$guard" >/dev/null 2>&1
assert_eq 0 "$?" "missing command fails open without terminal mutation"

finish_tests block-prompt-injection-hook
